// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

////////////////////////////////////////
// CORE IDENTITY
////////////////////////////////////////

model Person {
  uuid_id                   String         @id @default(uuid()) @db.Uuid // New UUID field
  first_name                String
  last_name                 String
  middle_name               String?
  suffix                    String?
  date_of_birth             DateTime
  gender                    String?
  email                     String?        @unique // Added unique for faster lookup
  contact_no                String?
  civil_status              String         @default("single")
  home_address              String?
  city_provice              String?
  nationality               String?
  country                   String?
  zip_code                  String?
  emergency_contact_person  String?
  emergency_contact_number  String?
  anonymization_preferences Json?
  other_person_data         Json?
  created_at                DateTime       @default(now())
  updated_at                DateTime       @updatedAt

  email_addresses           EmailAddress[]
  employee                  Employee?      @relation("PersonEmployee")
  users                     User[]

  @@index([last_name, first_name]) // Faster search for people by name
}

model EmailAddress {
  uuid_id       String   @id @default(uuid()) @db.Uuid // New UUID field
  person_uuid   String
  email_address String
  email_type    String
  is_primary    Boolean
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  person        Person   @relation(fields: [person_uuid], references: [uuid_id], onDelete:Cascade)

  @@index([person_uuid])
}

model User {
  uuid_id                  String               @id @default(uuid()) @db.Uuid // New UUID field
  employee_uuid            String               @unique
  person_uuid              String
  username                 String               @unique
  password                 String
  email                    String               @unique
  stat                     Int                  @default(1)
  password_reset           String?
  require_reset            Int                  @default(1)
  reports_to               Int?
  last_login               DateTime             @default(now())
  security_questions       Json?
  security_clearance_level Int?
  created_by               String?
  created_at               DateTime             @default(now())
  updated_at               DateTime             @updatedAt

  // Cascade delete tokens when user is removed
  password_reset_token         PasswordResetToken[]
  user_token                   UserToken[]
  user_roles                   UserRole[]
  user_permission              UserPermission[]
  PermissionTemplateDepartment PermissionTemplateDepartment[]
  audit_logs                   AuditLog[]

  employee                     Employee             @relation(fields: [employee_uuid], references: [uuid_id], onDelete: Cascade)
  person                       Person               @relation(fields: [person_uuid], references: [uuid_id], onDelete: Cascade)

  @@index([person_uuid])
  @@index([employee_uuid])
}

model UserLocation {
  uuid_id         String   @id @default(uuid()) @db.Uuid // New UUID field
  location_name   String
  address         String
  stat            Int      @default(1)
  created_at      DateTime @default(now())
  updated_at      DateTime @default(now())

  @@index([location_name])
  @@index([address])
}

model UserToken {
  uuid_id    String   @id @default(uuid()) @db.Uuid // New UUID field
  user_uuid  String
  user_token String   @unique
  status     Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user       User     @relation(fields: [user_uuid], references: [uuid_id], onDelete: Cascade)

  @@index([user_uuid])
}

model PasswordResetToken {
  uuid_id        String   @id @default(uuid()) @db.Uuid // New UUID field
  user_uuid      String
  expires_at     DateTime
  password_token String   @unique
  is_used        Boolean  @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  user           User     @relation(fields: [user_uuid], references: [uuid_id], onDelete: Cascade)

  @@index([user_uuid])
}

////////////////////////////////////////
// ORGANIZATION STRUCTURE
////////////////////////////////////////

model Company {
  uuid_id      String     @id @default(uuid()) @db.Uuid // New UUID field
  name         String
  address      String?
  telephone_no String?
  fax_no       String?
  company_tin  String?
  abbreviation String     @unique
  is_top_20000 Int        @default(0)
  stat         Int        @default(1)
  created_at   DateTime   @default(now())
  updated_at   DateTime   @updatedAt
  employee     Employee[]

  @@index([name])
  @@index([abbreviation])
}

model Division {
  uuid_id          String       @id @default(uuid()) @db.Uuid // New UUID field
  name             String
  division_head_uuid String?
  stat             Int          @default(1)
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt
  employee         Employee[]
  departments      Department[]

  @@index([name])
  @@index([division_head_uuid])
}

model Department {
  uuid_id            String       @id @default(uuid()) @db.Uuid // New UUID field
  name               String
  division_uuid      String
  sorting            Int?
  stat               Int          @default(1)
  department_head_uuid String?
  created_at         DateTime     @default(now())
  updated_at         DateTime     @updatedAt

  division           Division     @relation(fields: [division_uuid], references: [uuid_id])
  employees          Employee[]
  positions          Position[]
  role_permissions   RolePermission[]
  permission_templates PermissionTemplate[]
  permission_template_departments PermissionTemplateDepartment[]

  @@index([division_uuid])
}

model Position {
  uuid_id                      String                         @id @default(uuid()) @db.Uuid // New UUID field
  name                         String                         @db.VarChar(255)
  sorting                      Int?
  department_uuid              String
  stat                         Int                            @default(1)
  created_at                   DateTime                       @default(now())
  updated_at                   DateTime                       @updatedAt
  
  employee                     Employee[]
  department                   Department                     @relation(fields: [department_uuid], references: [uuid_id], onDelete: Cascade)
  RolePermission               RolePermission[]
  PermissionTemplateDepartment PermissionTemplateDepartment[]

  @@index([department_uuid])
}

model Employee {
  uuid_id                   String           @id @default(uuid()) @db.Uuid // New UUID field
  company_uuid              String
  person_uuid               String           @unique
  employee_uuid             String           @unique
  department_uuid           String
  position_uuid             String
  division_uuid             String
  hire_date                 DateTime
  salary                    Decimal
  pay_frequency             String
  employment_status_uuid    String
  monthly_equivalent_salary Decimal
  created_at                DateTime         @default(now())
  updated_at                DateTime         @updatedAt
  archive_date              DateTime?
  other_employee_data       Json?
  corporate_rank_uuid       String?

  employment_status         EmploymentStatus @relation(fields: [employment_status_uuid], references: [uuid_id])
  company                   Company          @relation(fields: [company_uuid], references: [uuid_id])
  department                Department       @relation(fields: [department_uuid], references: [uuid_id])
  person                    Person           @relation("PersonEmployee", fields: [person_uuid], references: [uuid_id], onDelete: Cascade)
  position                  Position         @relation(fields: [position_uuid], references: [uuid_id])
  division                  Division         @relation(fields: [division_uuid], references: [uuid_id])
  user                      User?

  @@index([department_uuid])
  @@index([company_uuid])
}

model EmploymentStatus {
  uuid_id    String     @id @default(uuid()) @db.Uuid // New UUID field
  code       String     @unique
  label      String
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  employees  Employee[]
}

////////////////////////////////////////
// ACCESS CONTROL / AUTHZ
////////////////////////////////////////

model Role {
  uuid_id             String               @id @default(uuid()) @db.Uuid // New UUID field
  name                String               @unique
  description         String
  stat                Int                  @default(1)
  created_at          DateTime             @default(now())
  updated_at          DateTime             @updatedAt
  
  role_permissions    RolePermission[]
  user_roles          UserRole[]
  permission_template PermissionTemplate[]
}

model UserRole {
  uuid_id          String           @id @default(uuid()) @db.Uuid // New UUID field
  user_uuid        String
  role_uuid        String
  role_name        String
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt

  user_permissions UserPermission[]
  role             Role             @relation(fields: [role_uuid], references: [uuid_id], onDelete: Cascade)
  user             User             @relation(fields: [user_uuid], references: [uuid_id], onDelete: Cascade)

  @@unique([user_uuid, role_uuid])
  @@index([user_uuid])
}

model RolePermission {
  uuid_id                  String         @id @default(uuid()) @db.Uuid // New UUID field
  role_uuid                String
  role_name                String
  action                   String
  sub_module_permission_uuid String
  sub_module_uuid            String
  department_uuid            String
  position_uuid              String?
  stat                     Int            @default(1)
  created_at               DateTime       @default(now())
  updated_at               DateTime       @updatedAt

  department               Department     @relation(fields: [department_uuid], references: [uuid_id])
  position                 Position?      @relation(fields: [position_uuid], references: [uuid_id])
  role                     Role           @relation(fields: [role_uuid], references: [uuid_id], onDelete: Cascade)
  sub_module_permission    SubModulePermission @relation(fields: [sub_module_permission_uuid], references: [uuid_id], onDelete: Cascade)
  sub_module               SubModule      @relation(fields: [sub_module_uuid], references: [uuid_id])

  permission_template_links PermissionTemplateRolePermission[]
  user_permission           UserPermission[]

  @@unique([role_uuid, sub_module_permission_uuid, action], map: "unique_role_permission")
  @@index([role_uuid])
  @@index([department_uuid])
}

model UserPermission {
  uuid_id            String         @id @default(uuid()) @db.Uuid // New UUID field
  action             String
  user_uuid          String
  user_role_uuid       String
  role_permission_uuid String
  created_at         DateTime       @default(now())
  updated_at         DateTime       @updatedAt

  role_permission    RolePermission? @relation(fields: [role_permission_uuid], references: [uuid_id], onDelete: Cascade)
  user               User            @relation(fields: [user_uuid], references: [uuid_id], onDelete: Cascade)
  user_role          UserRole        @relation(fields: [user_role_uuid], references: [uuid_id], onDelete: Cascade)

  @@unique([user_role_uuid, role_permission_uuid])
  @@index([user_uuid])
}

////////////////////////////////////////
// AUDIT TRAIL
////////////////////////////////////////'

model AuditLog {
  uuid_id       String  @id @default(uuid()) @db.Uuid // New UUID field
  //who performed the action
  user_uuid     String?
  user_email    String?
  employee_uuid String?    //link to employee for better tracking
  user          User?   @relation(fields: [user_uuid], references: [uuid_id], onDelete: SetNull)

  //what action was performed
  action        String  //'CREATE','READ','UPDATE','DELETE','LOGIN','LOGOUT', 'PERMISSION_DENIED', etc.
  resource      String  //'user_account','employee','salary','role_permisison', etc.
  resource_uuid String?    //ID of the affected record (if applicable)

  //details of the change
  old_values    Json?   //previos state (for UPDATE/DELETE)
  new_values    Json?   //new State (for CREATE/UPDATE)
  change_fields String[]  @default([]) //array of the field names that change_fields

  //context
  ip_address    String?
  user_agent    String?
  endpoint      String? //e.g., 'POST /api/users'
  http_method   String? //GET,POST,PUT,DELETE
  status_code   Int?    //200,403,500, etc.

  //result
  success       Boolean @default(true)
  error_message String? @db.Text //use text for longer error messages

  //metadata
  department_uuid String?    //track which department the action relates to
  session_id    String? //track user sessions
  request_id    String? //for correlating related operations

  //compliance & security
  severity      String? @default("INFO") //INFO, WARNING, CRITICAL
  compliance_flag Boolean @default(false) //flag for compliance-critical change_fields

  //timestamp
  created_at    DateTime  @default(now())

  //indexes for performance
  @@index([user_uuid])
  @@index([employee_uuid])
  @@index([resource, resource_uuid])
  @@index([created_at])
  @@index([action])
  @@index([department_uuid])
  @@index([session_id])
  @@index([success])
  @@map("audit_logs")  
}

////////////////////////////////////////
// MODULES & PERMISSIONS
////////////////////////////////////////

model Module {
  uuid_id    String      @id @default(uuid()) @db.Uuid // New UUID field
  name       String
  stat       Int         @default(1)
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt
  sub_module SubModule[]

  @@index([name])
}

model SubModule {
  uuid_id                String                @id @default(uuid()) @db.Uuid // New UUID field
  name                   String
  module_uuid            String
  stat                   Int                   @default(1)
  created_at             DateTime              @default(now())
  updated_at             DateTime              @updatedAt
  
  module                 Module                @relation(fields: [module_uuid], references: [uuid_id], onDelete: Cascade)
  role_permission        RolePermission[]
  sub_module_permissions SubModulePermission[]

  @@index([module_uuid])
}

model SubModuleAction {
  uuid_id               String                @id @default(uuid()) @db.Uuid // New UUID field
  action                String
  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt
  stat                  Int                   @default(1)
  sub_module_permission SubModulePermission[]
}

model SubModulePermission {
  uuid_id              String           @id @default(uuid()) @db.Uuid // New UUID field
  action                 String
  sub_module_action_uuid String
  sub_module_uuid        String
  created_at           DateTime         @default(now())
  updated_at           DateTime         @updatedAt
  
  role_permissions     RolePermission[]
  sub_module           SubModule        @relation(fields: [sub_module_uuid], references: [uuid_id], onDelete: Cascade)
  sub_module_action    SubModuleAction  @relation(fields: [sub_module_action_uuid], references: [uuid_id], onDelete: Cascade)

  @@index([sub_module_uuid])
}

////////////////////////////////////////
// PERMISSION TEMPLATES
////////////////////////////////////////

model PermissionTemplate {
  uuid_id         String   @id @default(uuid()) @db.Uuid // New UUID field
  name            String
  department_uuid String
  stat          Int      @default(1)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  department Department @relation(fields: [department_uuid], references: [uuid_id])

  departments      PermissionTemplateDepartment[] // includes user + department scope
  role_permissions PermissionTemplateRolePermission[]
  role             Role[]

  @@index([name])
}

model PermissionTemplateDepartment {
  uuid_id                  String           @id @default(uuid()) @db.Uuid // New UUID field
  permission_template_uuid String
  user_uuid                String
  department_uuid          String
  position_uuid            String?
  position               Position?          @relation(fields: [position_uuid], references: [uuid_id])
  department             Department         @relation(fields: [department_uuid], references: [uuid_id], onDelete: Cascade)
  permission_template    PermissionTemplate @relation(fields: [permission_template_uuid], references: [uuid_id])
  user                   User               @relation(fields: [user_uuid], references: [uuid_id])

  permission_template_role_permissions PermissionTemplateRolePermission[]

  @@unique([permission_template_uuid, department_uuid])
  @@index([permission_template_uuid])
  @@index([position_uuid])
  @@index([user_uuid])
}

model PermissionTemplateRolePermission {
  uuid_id                           String                    @id @default(uuid()) @db.Uuid // New UUID field
  permission_template_uuid          String
  role_permission_uuid              String
  permission_template_department_uuid String

  permission_template            PermissionTemplate           @relation(fields: [permission_template_uuid], references: [uuid_id], onDelete: Cascade)
  role_permissions               RolePermission               @relation(fields: [role_permission_uuid], references: [uuid_id])
  permission_template_department PermissionTemplateDepartment @relation(fields: [permission_template_department_uuid], references: [uuid_id], onDelete: Cascade)

  @@unique([permission_template_uuid, role_permission_uuid, permission_template_department_uuid])
  @@index([permission_template_uuid])
  @@index([permission_template_department_uuid])
  @@index([role_permission_uuid])
}